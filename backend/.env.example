SECRET_KEY=change-me-super-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=sqlite:///./sql_app.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://127.0.0.1:3000
ADMIN_EMAILS=admin@example.com

# SMTP: приветствие при регистрации, письмо об оформлении заказа
# Если SMTP_HOST/SMTP_USER/SMTP_PASSWORD пусты — текст писем в консоли бэкенда
# Gmail: включите 2FA → пароль приложения → https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=your@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=your@gmail.com
EMAIL_FROM_NAME=VogueWay
# Опционально: другой адрес в «От кого» (сначала добавьте alias в Gmail)
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com
VERIFICATION_CODE_TTL_MINUTES=10
DEBUG=true
# Поиск по фото: false = включён (нужен sentence-transformers в venv)
DISABLE_AI_SEARCH=false
