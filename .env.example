# Скопируйте в .env в корне репозитория: cp .env.example .env
# Затем: docker compose up -d --build

# --- Postgres (контейнер db) ---
POSTGRES_USER=vogueway
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=vogueway

# --- Публичные URL (для браузера и сборки фронта) ---
# Без домена: http://ВАШ_IP и http://ВАШ_IP:8000
PUBLIC_SITE_URL=http://localhost
PUBLIC_API_URL=http://localhost:8000

# --- Backend ---
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
DEBUG=false
CORS_ORIGINS=http://localhost,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost
ADMIN_EMAILS=you@example.com

# Поиск по фото (CLIP). Нужно ~4 GB RAM на VPS; при нехватке памяти: INSTALL_AI=0 и DISABLE_AI_SEARCH=true
INSTALL_AI=1
DISABLE_AI_SEARCH=false

# SMTP (Gmail: пароль приложения)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=VogueWay
